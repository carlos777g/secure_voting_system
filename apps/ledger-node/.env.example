NODE_ID=node-a
ROLE=primary
PORT=4001
DATA_PATH=data/node-a.json
KEYS_DIR=keys
AUTHORITY_URL=http://localhost:4000
# PEM of the election's RSA-OAEP public key, served read-only at
# GET /election-key for voter-client. Generate a placeholder for local dev
# with: node scripts/generate-election-key.js
ELECTION_PUBLIC_KEY_PATH=keys/election_public.pem
# Comma-separated peer base URLs. On a replica, the FIRST entry must be the
# primary's URL (used both for broadcast-target discovery and to fetch the
# primary's public key at startup).
PEERS=
